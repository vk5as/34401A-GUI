{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_guard_bash.py\"",
            "timeout": 10,
            "statusMessage": "Checking the command against the repo's shell guard"
          }
        ]
      }
    ]
  }
}
